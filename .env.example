SECRET_KEY=reemplazar-por-una-clave-secreta-larga
DEBUG=False
ALLOWED_HOSTS=tuusuario.pythonanywhere.com
# En producción se activan HTTPS, cookies seguras y HSTS. Solo cambie estos
# valores si su infraestructura HTTPS ya los gestiona externamente.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=usuario@example.com
SMTP_PASSWORD=usar-una-contrasena-de-aplicacion
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_FROM_EMAIL=usuario@example.com
SMTP_FROM_NAME=Dulce Atardecer
